{
  "name": "loadform",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:js": "node --experimental-vm-modules src/templates.test.js && node src/loads.test.js && node src/organizations.test.js",
    "test:rs": "cd src-tauri && cargo test",
    "test:deno": "deno test --allow-net supabase/functions/_shared/rubric.test.ts",
    "test:sql": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/tests/void_aborted_captures.test.sql",
    "test": "npm run test:js && npm run test:deno && npm run test:rs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^5"
  }
}
